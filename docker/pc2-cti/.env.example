# ===========================================================
# VM CTI (pc3-threat-intel, 100.64.0.13) — environment vars
# ===========================================================
# Copy this file to .env and fill in the real values.
# The .env file is gitignored; only .env.example is committed.

# --- MISP — MariaDB ---
MYSQL_ROOT_PASSWORD=<REDACTED>
MYSQL_USER=misp
MYSQL_PASSWORD=<REDACTED>

# --- MISP — Redis ---
MISP_REDIS_PASSWORD=<REDACTED>

# --- MISP — admin account ---
MISP_ADMIN_EMAIL=admin@soc.local
MISP_ADMIN_PASSWORD=<REDACTED>

# --- MISP — API key (used by OpenCTI connector) ---
MISP_API_KEY=<REDACTED>

# --- OpenCTI — Redis ---
OPENCTI_REDIS_PASSWORD=<REDACTED>

# --- OpenCTI — MinIO ---
OPENCTI_MINIO_USER=opencti_minio
OPENCTI_MINIO_PASSWORD=<REDACTED>

# --- OpenCTI — RabbitMQ ---
OPENCTI_RABBITMQ_USER=opencti_rabbit
OPENCTI_RABBITMQ_PASSWORD=<REDACTED>

# --- OpenCTI — PostgreSQL ---
OPENCTI_POSTGRES_USER=opencti
OPENCTI_POSTGRES_PASSWORD=<REDACTED>

# --- OpenCTI — admin account ---
OPENCTI_ADMIN_EMAIL=admin@soc.local
OPENCTI_ADMIN_PASSWORD=<REDACTED>

# --- OpenCTI — admin token + session secret ---
OPENCTI_ADMIN_TOKEN=<REDACTED>
OPENCTI_SESSION_SECRET=<REDACTED>

# --- AbuseIPDB ---
ABUSEIPDB_API_KEY=<REDACTED>
