# ===========================================================
# VM SOC (pc1-soc, 100.64.0.11) — environment variables
# ===========================================================
# Copy this file to .env and fill in the real values.
# The .env file is gitignored; only .env.example is committed.

# --- PostgreSQL (n8n + socdb) ---
POSTGRES_USER=n8n
POSTGRES_PASSWORD=<REDACTED>
POSTGRES_DB=socdb

# --- RabbitMQ ---
RABBITMQ_USER=<REDACTED>
RABBITMQ_PASSWORD=<REDACTED>

# --- n8n ---
N8N_HOST=100.64.0.11
N8N_USER=<REDACTED>
N8N_PASSWORD=<REDACTED>
TZ=Africa/Tunis

# --- Wazuh indexer (OpenSearch) ---
INDEXER_USERNAME=admin
INDEXER_PASSWORD=<REDACTED>

# --- Wazuh Dashboard ---
DASHBOARD_USERNAME=kibanaserver
DASHBOARD_PASSWORD=<REDACTED>

# --- Wazuh API (REST on port 55000) ---
API_USERNAME=wazuh-wui
API_PASSWORD=<REDACTED>